[Unit]
Description=memory-anywhere secrets (LLM key from SSM into /run/memory-anywhere/secrets.env)
After=network-online.target systemd-tmpfiles-setup.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=ma-aws
Group=ma-aws
EnvironmentFile=/etc/memory-anywhere/stack.env
ExecStart=/usr/local/libexec/memory-anywhere/secrets.sh
# '+': as root, hand the file to the server user (0400) and remove the staging copy.
ExecStartPost=+/bin/sh -c 'install -m 0400 -o memory-anywhere -g memory-anywhere /run/ma-aws-secrets/secrets.env /run/memory-anywhere/secrets.env && rm -f /run/ma-aws-secrets/secrets.env'
RuntimeDirectory=ma-aws-secrets
Environment=HOME=/run/ma-aws-secrets
RuntimeDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target

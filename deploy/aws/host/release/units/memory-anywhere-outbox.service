[Unit]
Description=memory-anywhere outbox helper

[Service]
Type=oneshot
User=ma-aws
Group=ma-aws
# Files it writes in the setgid drop directory get group memory-anywhere from the directory.
RuntimeDirectory=ma-aws-outbox
RuntimeDirectoryMode=0700
Environment=HOME=/run/ma-aws-outbox
EnvironmentFile=/etc/memory-anywhere/stack.env
ExecStart=/usr/local/libexec/memory-anywhere/outbox.sh
UMask=0007
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/run/memory-anywhere/outbox /run/memory-anywhere/inbox/drop

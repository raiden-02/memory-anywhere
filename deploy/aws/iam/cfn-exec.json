{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Ec2ReadAll",
      "Effect": "Allow",
      "Action": ["ec2:Describe*", "ec2:GetInstanceMetadataDefaults", "ec2:GetLaunchTemplateData"],
      "Resource": "*"
    },
    {
      "Sid": "Ec2StackResources",
      "Effect": "Allow",
      "Action": ["ec2:CreateVpc", "ec2:DeleteVpc", "ec2:ModifyVpcAttribute", "ec2:CreateSubnet", "ec2:DeleteSubnet", "ec2:ModifySubnetAttribute", "ec2:CreateRouteTable", "ec2:DeleteRouteTable", "ec2:AssociateRouteTable", "ec2:DisassociateRouteTable", "ec2:CreateRoute", "ec2:DeleteRoute", "ec2:ReplaceRoute", "ec2:CreateInternetGateway", "ec2:DeleteInternetGateway", "ec2:AttachInternetGateway", "ec2:DetachInternetGateway", "ec2:CreateVpcEndpoint", "ec2:DeleteVpcEndpoints", "ec2:ModifyVpcEndpoint", "ec2:CreateSecurityGroup", "ec2:DeleteSecurityGroup", "ec2:AuthorizeSecurityGroupIngress", "ec2:AuthorizeSecurityGroupEgress", "ec2:RevokeSecurityGroupIngress", "ec2:RevokeSecurityGroupEgress", "ec2:AllocateAddress", "ec2:ReleaseAddress", "ec2:AssociateAddress", "ec2:DisassociateAddress", "ec2:CreateLaunchTemplate", "ec2:CreateLaunchTemplateVersion", "ec2:ModifyLaunchTemplate", "ec2:DeleteLaunchTemplate", "ec2:DeleteLaunchTemplateVersions", "ec2:RunInstances", "ec2:TerminateInstances", "ec2:StartInstances", "ec2:StopInstances", "ec2:ModifyInstanceAttribute", "ec2:ModifyInstanceMetadataOptions", "ec2:ModifyInstanceCreditSpecification", "ec2:AssociateIamInstanceProfile", "ec2:DisassociateIamInstanceProfile", "ec2:ReplaceIamInstanceProfileAssociation", "ec2:CreateTags", "ec2:DeleteTags"],
      "Resource": "*"
    },
    {
      "Sid": "IamRolesOnlyWithBoundary",
      "Effect": "Allow",
      "Action": ["iam:CreateRole", "iam:PutRolePolicy", "iam:DeleteRolePolicy", "iam:AttachRolePolicy", "iam:DetachRolePolicy", "iam:PutRolePermissionsBoundary"],
      "Resource": "arn:aws:iam::${ACCOUNT_ID}:role/memory-anywhere-*",
      "Condition": {
        "StringEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::${ACCOUNT_ID}:policy/memory-anywhere-boundary"
        }
      }
    },
    {
      "Sid": "IamOnlyTheDlmManagedPolicyMayBeAttached",
      "Effect": "Deny",
      "Action": ["iam:AttachRolePolicy"],
      "Resource": "*",
      "Condition": {
        "ArnNotEquals": {
          "iam:PolicyARN": "arn:aws:iam::aws:policy/service-role/AWSDataLifecycleManagerServiceRole"
        }
      }
    },
    {
      "Sid": "IamRoleLifecycle",
      "Effect": "Allow",
      "Action": ["iam:GetRole", "iam:GetRolePolicy", "iam:ListRolePolicies", "iam:ListAttachedRolePolicies", "iam:ListInstanceProfilesForRole", "iam:UpdateRole", "iam:UpdateRoleDescription", "iam:UpdateAssumeRolePolicy", "iam:TagRole", "iam:UntagRole", "iam:DeleteRole"],
      "Resource": "arn:aws:iam::${ACCOUNT_ID}:role/memory-anywhere-*"
    },
    {
      "Sid": "IamInstanceProfiles",
      "Effect": "Allow",
      "Action": ["iam:CreateInstanceProfile", "iam:DeleteInstanceProfile", "iam:GetInstanceProfile", "iam:AddRoleToInstanceProfile", "iam:RemoveRoleFromInstanceProfile", "iam:TagInstanceProfile", "iam:UntagInstanceProfile"],
      "Resource": "arn:aws:iam::${ACCOUNT_ID}:instance-profile/memory-anywhere-*"
    },
    {
      "Sid": "IamPassRoleOnlyToEc2AndDlm",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::${ACCOUNT_ID}:role/memory-anywhere-*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": ["ec2.amazonaws.com", "dlm.amazonaws.com"]
        }
      }
    },
    {
      "Sid": "KmsCreate",
      "Effect": "Allow",
      "Action": ["kms:CreateKey", "kms:ListAliases"],
      "Resource": "*"
    },
    {
      "Sid": "KmsManageStackKeys",
      "Effect": "Allow",
      "Action": ["kms:DescribeKey", "kms:GetKeyPolicy", "kms:PutKeyPolicy", "kms:GetKeyRotationStatus", "kms:EnableKeyRotation", "kms:TagResource", "kms:UntagResource", "kms:ListResourceTags", "kms:CreateAlias", "kms:UpdateAlias", "kms:DeleteAlias"],
      "Resource": ["arn:aws:kms:${REGION}:${ACCOUNT_ID}:key/*", "arn:aws:kms:${REGION}:${ACCOUNT_ID}:alias/memory-anywhere-*"]
    },
    {
      "Sid": "KmsScheduleDeletionNonProdOnly",
      "Effect": "Allow",
      "Action": "kms:ScheduleKeyDeletion",
      "Resource": "arn:aws:kms:${REGION}:${ACCOUNT_ID}:key/*",
      "Condition": {
        "Null": {
          "aws:ResourceTag/memory-anywhere:stage": "false"
        },
        "StringNotEquals": {
          "aws:ResourceTag/memory-anywhere:stage": "prod"
        }
      }
    },
    {
      "Sid": "KmsEbsGrantsForAwsResources",
      "Effect": "Allow",
      "Action": ["kms:CreateGrant"],
      "Resource": "arn:aws:kms:${REGION}:${ACCOUNT_ID}:key/*",
      "Condition": {
        "Bool": {
          "kms:GrantIsForAWSResource": "true"
        }
      }
    },
    {
      "Sid": "KmsEbsUseViaEc2",
      "Effect": "Allow",
      "Action": ["kms:GenerateDataKeyWithoutPlaintext", "kms:Decrypt", "kms:ReEncrypt*", "kms:DescribeKey"],
      "Resource": "arn:aws:kms:${REGION}:${ACCOUNT_ID}:key/*",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "ec2.${REGION}.amazonaws.com"
        }
      }
    },
    {
      "Sid": "NeverUsedByTheStack",
      "Effect": "Deny",
      "Action": ["lambda:*", "organizations:*", "account:*", "sso:*", "identitystore:*", "iam:CreateUser", "iam:CreateAccessKey", "iam:CreateLoginProfile", "iam:CreatePolicy", "iam:CreatePolicyVersion", "iam:SetDefaultPolicyVersion", "iam:DeletePolicy", "iam:DeleteRolePermissionsBoundary"],
      "Resource": "*"
    }
  ]
}

{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudFormationOnMemoryAnywhereStacks",
      "Effect": "Allow",
      "Action": "cloudformation:*",
      "Resource": "arn:aws:cloudformation:*:${ACCOUNT_ID}:stack/MemoryAnywhere-*/*"
    },
    {
      "Sid": "AssumeCdkBootstrapRoles",
      "Effect": "Allow",
      "Action": "sts:AssumeRole",
      "Resource": [
        "arn:aws:iam::${ACCOUNT_ID}:role/cdk-*-deploy-role-*",
        "arn:aws:iam::${ACCOUNT_ID}:role/cdk-*-file-publishing-role-*",
        "arn:aws:iam::${ACCOUNT_ID}:role/cdk-*-lookup-role-*"
      ]
    },
    {
      "Sid": "UploadReleases",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::memory-anywhere-releases-*/*"
    },
    {
      "Sid": "ProdReleaseAndAcmeParameters",
      "Effect": "Allow",
      "Action": ["ssm:PutParameter", "ssm:GetParameter"],
      "Resource": [
        "arn:aws:ssm:*:${ACCOUNT_ID}:parameter/memory-anywhere/release/*",
        "arn:aws:ssm:*:${ACCOUNT_ID}:parameter/memory-anywhere/acme/*"
      ]
    },
    {
      "Sid": "NonProdStageParameters",
      "Effect": "Allow",
      "Action": ["ssm:GetParameter*", "ssm:PutParameter"],
      "Resource": [
        "arn:aws:ssm:*:${ACCOUNT_ID}:parameter/memory-anywhere-spike/*",
        "arn:aws:ssm:*:${ACCOUNT_ID}:parameter/memory-anywhere-eval-*/*"
      ]
    },
    {
      "Sid": "EmptyNonProdBucketsOnDestroy",
      "Effect": "Allow",
      "Action": ["s3:ListBucketVersions", "s3:DeleteObject", "s3:DeleteObjectVersion"],
      "Resource": [
        "arn:aws:s3:::memory-anywhere-*-spike", "arn:aws:s3:::memory-anywhere-*-spike/*",
        "arn:aws:s3:::memory-anywhere-*-eval-*", "arn:aws:s3:::memory-anywhere-*-eval-*/*"
      ]
    },
    {
      "Sid": "DecryptEvalParameters",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "arn:aws:kms:*:${ACCOUNT_ID}:key/*",
      "Condition": {
        "StringLike": {
          "kms:ViaService": "ssm.*.amazonaws.com",
          "kms:EncryptionContext:PARAMETER_ARN": "arn:aws:ssm:*:${ACCOUNT_ID}:parameter/memory-anywhere-eval-*/*"
        }
      }
    },
    {
      "Sid": "DeleteNonProdParametersOnDestroy",
      "Effect": "Allow",
      "Action": ["ssm:GetParametersByPath", "ssm:DeleteParameter", "ssm:DeleteParameters"],
      "Resource": [
        "arn:aws:ssm:*:${ACCOUNT_ID}:parameter/memory-anywhere-spike", "arn:aws:ssm:*:${ACCOUNT_ID}:parameter/memory-anywhere-spike/*",
        "arn:aws:ssm:*:${ACCOUNT_ID}:parameter/memory-anywhere-eval-*", "arn:aws:ssm:*:${ACCOUNT_ID}:parameter/memory-anywhere-eval-*/*"
      ]
    },
    {
      "Sid": "DeleteNonProdSnapshotsOnDestroy",
      "Effect": "Allow",
      "Action": "ec2:DeleteSnapshot",
      "Resource": "arn:aws:ec2:*::snapshot/*",
      "Condition": { "StringLike": { "aws:ResourceTag/memory-anywhere:stage": ["spike", "eval-*"] } }
    },
    {
      "Sid": "ReadOnly",
      "Effect": "Allow",
      "Action": ["ec2:Describe*", "ec2:GetInstanceMetadataDefaults", "cloudformation:Describe*", "budgets:ViewBudget"],
      "Resource": "*"
    },
    {
      "Sid": "DenySessionsAndCommands",
      "Effect": "Deny",
      "Action": ["ssm:StartSession", "ssm:SendCommand"],
      "Resource": "*"
    },
    {
      "Sid": "DenyProdSecrets",
      "Effect": "Deny",
      "Action": "ssm:GetParameter*",
      "Resource": [
        "arn:aws:ssm:*:${ACCOUNT_ID}:parameter/memory-anywhere/llm/*",
        "arn:aws:ssm:*:${ACCOUNT_ID}:parameter/memory-anywhere/setup-token"
      ]
    },
    {
      "Sid": "DenyProdBackupsAndManifests",
      "Effect": "Deny",
      "Action": ["s3:GetObject*", "s3:Delete*"],
      "Resource": [
        "arn:aws:s3:::memory-anywhere-backup-*-prod", "arn:aws:s3:::memory-anywhere-backup-*-prod/*",
        "arn:aws:s3:::memory-anywhere-manifest-*-prod", "arn:aws:s3:::memory-anywhere-manifest-*-prod/*"
      ]
    },
    {
      "Sid": "DenyKeyDestruction",
      "Effect": "Deny",
      "Action": ["kms:ScheduleKeyDeletion", "kms:DisableKey", "kms:PutKeyPolicy"],
      "Resource": "*"
    },
    {
      "Sid": "DenyDecryptOutsideSsm",
      "Effect": "Deny",
      "Action": "kms:Decrypt",
      "Resource": "*",
      "Condition": { "StringNotLike": { "kms:ViaService": "ssm.*.amazonaws.com" } }
    },
    {
      "Sid": "DenyDecryptOutsideEvalParameters",
      "Effect": "Deny",
      "Action": "kms:Decrypt",
      "Resource": "*",
      "Condition": { "StringNotLike": { "kms:EncryptionContext:PARAMETER_ARN": "arn:aws:ssm:*:${ACCOUNT_ID}:parameter/memory-anywhere-eval-*/*" } }
    },
    {
      "Sid": "DenyIdentityOrgAndShell",
      "Effect": "Deny",
      "Action": ["iam:*", "sso:*", "identitystore:*", "organizations:*", "cloudshell:*"],
      "Resource": "*"
    }
  ]
}

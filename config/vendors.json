  "coding": {
    "claude-code": {
      "adr": "ADR-0105, ADR-0109, ADR-0110",
      "version_tested": "2.1.319",
      "install": "plugin",
      "plugin_loads": { "mcp": true, "hooks": true, "settings_permissions_deny": false },
      "always_load": { "mcp_json_alwaysLoad": true, "tool_meta_anthropic_alwaysLoad": true },
      "server_instructions_reach_model": true,
      "disable_claude_ai_copy": { "settings_key": "deniedMcpServers", "entry": { "serverName": "claude.ai <connector name>" } },
      "hooks": { "session_start": "SessionStart", "prompt": "UserPromptSubmit" }
    },
    "codex": {
      "adr": "ADR-0109, ADR-0110",
      "version_tested": "0.167.0",
      "install": "plugin from a local marketplace (~/.agents/plugins/marketplace.json)",
      "plugin_manifest": ".codex-plugin/plugin.json with \"mcpServers\": \"./.mcp.json\" and inline \"hooks\"",
      "plugin_loads": { "mcp": true, "hooks": "after owner trust" },
      "hook_trust": "config.toml [hooks.state.\"<plugin>@<marketplace>:plugin.json#hooks[0]:<event>:0:0\"] trusted_hash; untrusted hooks are skipped silently",
      "server_instructions_reach_model": true,
      "session_start_stdout": ["hookSpecificOutput.additionalContext JSON", "plain text"],
      "hooks": { "session_start": "SessionStart", "prompt": "UserPromptSubmit" }
    },
    "cursor": {
      "adr": "ADR-0109, ADR-0110",
      "version_tested": "3.29.9",
      "install": "plugin (MCP server and alwaysApply rule) + ~/.cursor/hooks.json written by mema init",
      "plugin_loads": { "mcp": true, "hooks": false, "rules_every_workspace": true },
      "hook_command": "node \"<abs>\\memory-anywhere.mjs\" hook cursor <event>; <abs> must not be under %LOCALAPPDATA%",
      "payload_cwd": "workspace_roots[0] (URL-style /C:/...), else CURSOR_PROJECT_DIR",
      "event_order_fixed": false,
      "server_instructions_reach_model": "pending owner check",
      "hooks": { "session_start": "sessionStart", "prompt": "beforeSubmitPrompt" }
    }

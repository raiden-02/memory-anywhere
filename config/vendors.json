        "discovery": "oauth-protected-resource, then /.well-known/openid-configuration"
      },
      "mcp": { "protocol": "2026-07-28 (server/discover)", "server_instructions_reach_model": false, "elicitation": "none", "write_approval": "ChatGPT approval card on every save (Always allow available)" },
      "setup": {
        "add_server": "chatgpt.com/plugins > Add > Add custom MCP server; Authentication OAuth; Advanced OAuth settings > User-Defined OAuth Client",
        "refresh_tools": "plugin settings > Refresh tools (after a server tool change)",
        "custom_instruction": { "path": "Settings > Personalization > Custom instructions > ChatGPT instructions", "max_chars": null },
        "tunnel": "Connection > Tunnel (tunnel id) is offered on Plus (Q24)"
      },
      "surfaces": { "web_pc": "works (read and write)", "desktop": "pending owner check", "phone_app": "pending owner check", "phone_browser": "pending owner check", "codex": "appears as codex_apps tools (ADR-0110)" }

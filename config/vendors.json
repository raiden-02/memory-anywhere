    "gemini": {
      "adr": "ADR-0107",
      "oauth": {
        "method": "static",
        "fallbacks": ["dcr"],
        "token_endpoint_auth_method": "client_secret_basic",
        "redirect_uri_rule": {
          "prefix": "https://oauth-redirect.googleusercontent.com/r/user_bound_custom-mcp-",
          "rest": "<Google user id>-<this server's host with dots as underscores>",
          "regex_template": "^https://oauth-redirect\\.googleusercontent\\.com/r/user_bound_custom-mcp-[0-9]{1,32}-{host_underscored}$"
        },
        "refresh_rotation": "fixed (rotate also tested and works)",
        "scopes_requested": "memory.read memory.write",
        "discovery": "oauth-protected-resource, then /.well-known/openid-configuration"
      },
      "mcp": { "protocol": "2025-11-25 (initialize)", "server_instructions_reach_model": false, "elicitation": "none", "models_that_call_tools": ["3.1 Pro"], "write_approval": "Gemini approval card on every tool call" },
      "setup": {
        "add_server": "gemini.google.com > Settings > Developer Mode > Choose an app > Create new > Connect to an MCP server; Additional settings: Client ID, Client secret; finish with Save your custom app > Connect",

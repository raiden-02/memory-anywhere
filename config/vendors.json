        "method": "static",
        "fallbacks": [],
        "token_endpoint_auth_method": "client_secret_basic",
        "redirect_uris": ["https://claude.ai/api/mcp/auth_callback"],
        "cimd_client_id_patterns": [],
        "scopes_requested": "memory.read memory.write offline_access",
        "discovery": "not recorded (static client)"
      },
      "mcp": { "protocol": "2026-07-28 (server/discover)", "server_instructions_reach_model": false, "elicitation": "verified-possible", "tool_loading": "account-wide: Settings > Capabilities > Advanced > Connectors in new chats" },
      "setup": {
        "add_server": "claude.ai > Customize > Connectors > Add custom connector; Advanced settings: OAuth Client ID and Client Secret",

<% layout("./admin") %>
<h1>Private topics</h1>
<p class="muted">A memory on a private topic is saved only with your approval and recalled only by the apps you allow for that topic. Other topics are saved and recalled like any memory.</p>
<form class="act stack" data-action="settings.private_topics">
  <fieldset class="choices"><legend class="muted">Private</legend>
    <% for (const t of it.topics) { %><label><input type="checkbox" name="private" value="<%= t.category %>" data-type="list"<% if (t.private) { %> checked<% } %>> <%= it.fmt.topic(t.category) %></label><% } %>
  </fieldset>
  <button type="submit" class="secondary">Save private topics</button>
</form>
<h1>LLM spend</h1>
<p class="muted">Capped at $<%= it.cap.toFixed(2) %> a day; past it the server works without the LLM until midnight UTC.</p>
<table class="table"><thead><tr><th>Day</th><th>Use</th><th>USD</th><th>Tokens in / out</th></tr></thead><tbody>
<% for (const s of it.spend) { %><tr><td><%= s.day %></td><td><%= s.purpose %></td><td><%= s.usd.toFixed(4) %></td><td><%= s.tokens_in %> / <%= s.tokens_out %></td></tr><% } %>
</tbody></table>
<h1>Alerts</h1>
<p class="muted">The daily digest goes out at <%= it.digestHour %>:00 your time (server.toml <span class="code">alerts.digest_hour_local</span>).</p>
<ul class="list"><% for (const a of it.alerts) { %><li><strong><%= it.fmt.alert(a.kind) %></strong> <span class="muted"><%= a.subject %> ×<%= a.count %> · <%~ it.fmt.time(a.last_at) %></span></li><% } %></ul>
<% if (it.alerts.length === 0) { %><p class="muted">No open alerts.</p><% } %>
<% if (it.recoveryCodesLeft !== undefined) { %>
<h1>Recovery codes</h1>
<p class="muted"><%= it.recoveryCodesLeft %> of 10 unused. New codes replace every old one.</p>
<button type="button" id="new-codes">New recovery codes</button>
<section id="codes-step" hidden>
  <p>Save them now: they are shown once.</p>
  <ol id="codes" class="code"></ol>
  <label for="confirm-code">Type one of them</label>
  <input id="confirm-code" autocomplete="off" autocapitalize="characters" spellcheck="false">
  <button id="confirm-codes" type="button">Done</button>
</section>
<% } %>

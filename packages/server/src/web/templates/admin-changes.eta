<% layout("./admin") %>
<h1>Recent changes</h1>
<ul class="list">
<% for (const c of it.rows) { %>
  <li><span class="muted"><%= c.at %> · <%= c.actor %> · <%= c.op %></span><% if (c.content) { %><br><a href="<%= it.root ?? "" %>/memories/<%= c.memory_id %>"><%= c.content %></a><% } %>
  <% if (c.op === "memory.forget" && c.status === "forgotten") { %><form class="act inline" data-action="memory.undo"><input type="hidden" name="id" value="<%= c.memory_id %>"><button type="submit" class="secondary">Undo</button></form><% } %>
  <% if (c.op === "memory.insert" && (c.status === "active" || c.status === "contested")) { %><form class="act inline" data-action="memory.forget"><input type="hidden" name="id" value="<%= c.memory_id %>"><button type="submit" class="secondary">Undo</button></form><% } %>
  </li>
<% } %>
</ul>

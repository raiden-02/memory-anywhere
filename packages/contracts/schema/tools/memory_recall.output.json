        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^mem_[0-9A-HJKMNP-TV-Z]{26}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "fact",
              "preference",
              "instruction",
              "event"
            ]
          },
          "entity": {
            "type": "string"
          },
          "section": {
            "type": "string"
          },
          "attribute": {
            "type": [
              "string",
              "null"
            ]
          },
          "content": {
            "type": "string",
            "maxLength": 400
          },
          "valid_from": {
            "type": [
              "string",
              "null"
            ]
          },
          "valid_to": {
            "type": [
              "string",
              "null"
            ]
          },
          "recorded_at": {
            "type": "string",
            "format": "date-time"
          },
          "tier": {
            "type": "string",
            "enum": [
              "T0",
              "T1",
              "T2",
              "T3"
            ]
          },
          "status": {
            "type": "string",

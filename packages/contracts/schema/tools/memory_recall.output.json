              "type": "string",
              "pattern": "^mem_[0-9A-HJKMNP-TV-Z]{26}$"
            }
          },
          "via": {
            "type": "string",
            "description": "display name of the client of the first source"
          },
          "expires_at": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "entity",
          "section",
          "content",
          "recorded_at",
          "tier",
          "status",
          "via"
        ],
        "additionalProperties": false
      }
    },
    "truncated": {
      "type": "boolean"
    },
    "budget_exhausted": {
      "type": "boolean"
    },
    "offline": {
      "type": "boolean"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }

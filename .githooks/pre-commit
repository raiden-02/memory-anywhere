#!/bin/sh
# Refuse a commit whose index contains the owner's private hostname (MA_DOMAIN).
. "$(dirname "$0")/ma-domain.sh"
matches="$(git grep --cached -i -F -l -e "$ma_domain" -- .)"
if [ -n "$matches" ]; then
  echo "memory-anywhere guard: staged files contain the owner domain (MA_DOMAIN):" >&2
  echo "$matches" >&2
  exit 1
fi
exit 0

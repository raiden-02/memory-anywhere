#!/bin/sh
# Refuse a commit message that contains the maintainer's private hostname (MA_DOMAIN), when one is set.
. "$(dirname "$0")/ma-domain.sh"
if [ -n "$MA_DOMAIN" ] && grep -i -F -q -e "$MA_DOMAIN" "$1"; then
  echo "memory-anywhere guard: the commit message contains the maintainer's domain (MA_DOMAIN)." >&2
  exit 1
fi
exit 0

{
	"name": "memory-anywhere-workspace",
	"private": true,
	"license": "MIT",
	"type": "module",
	"packageManager": "pnpm@12.18.0",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"prepare": "git config core.hooksPath .githooks",
		"typecheck": "tsc -p tsconfig.json && tsc -p deploy/aws/tsconfig.json",
		"lint": "eslint .",
		"test": "vitest run",
		"check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm check:repo && pnpm check:links && pnpm test",
		"check:repo": "node scripts/check-repo.ts",
		"check:links": "node scripts/check-links.ts",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"scrub": "node scripts/scrub-evidence.ts",
		"eval": "node evals/harness/cli.ts",
		"gen": "node scripts/gen.ts",
		"build": "node scripts/build.ts",
		"pack:client": "node scripts/pack.ts",
		"pack:server": "node scripts/pack-server.ts"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@types/node": "24.19.2",
		"esbuild": "0.28.2",
		"eslint": "10.14.0",
		"fast-check": "4.10.2",
		"prettier": "3.9.10",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.1",
		"vitest": "5.1.0"
	}
}
